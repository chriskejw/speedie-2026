<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Learn how to play Speedie, the reaction color challenge.">
  <meta property="og:title" content="How to Play Speedie">
  <meta property="og:description" content="Click the target that matches the word's font color.">
  <meta property="og:image" content="/assets/social/og-image-1200x630.png">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#101827">
  <meta name="msapplication-TileColor" content="#101827">
  <meta name="msapplication-TileImage" content="/assets/icons/mstile-150x150.png">
  <title>How to Play Speedie</title>
  <link rel="icon" href="/assets/favicon/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon/favicon-48x48.png">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
  <header class="siteHeader">
    <a class="brand" href="/" aria-label="Speedie home">
      <img src="/assets/logo/speedie-logo-transparent.png" alt="Speedie">
    </a>
    <nav class="navLinks" aria-label="Main navigation">
      <a aria-current="page" href="/instructions">How to play</a>
      <a class="navAction" href="/play">Play</a>
    </nav>
  </header>

  <main class="rulesScreen">
    <section class="rulesPanel">
      <p class="eyebrow">The rule</p>
      <h1>Click the box that matches the word color.</h1>
      <div class="ruleDemo" aria-label="Example prompt">
        <span class="demoWord">Blue</span>
        <span class="demoArrow">→</span>
        <span class="demoTarget"></span>
      </div>
      <ol class="ruleList">
        <li>Look at the color of the word, not the letters.</li>
        <li>Click the matching colored target in the play zone.</li>
        <li>Finish 20 rounds before the score reaches zero.</li>
        <li>Wrong clicks cost time. Correct clicks add a small bonus.</li>
      </ol>
      <a class="button primary" href="/play">Start playing</a>
    </section>
  </main>
</body>

</html>
